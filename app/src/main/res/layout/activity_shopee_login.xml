<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_main"
    android:orientation="vertical">

    <!-- Top Bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:background="@drawable/bg_header_orange"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Đăng Nhập Shopee Lấy Cookie"
            android:textColor="@color/text_white"
            android:textSize="15sp"
            android:textStyle="bold" />

        <Button
            android:id="@+id/btnDoneExtract"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:backgroundTint="@color/status_connected"
            android:text="LƯU TỰ ĐỘNG"
            android:textColor="@color/text_white"
            android:textSize="11sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Info banner -->
    <TextView
        android:id="@+id/tvCookieStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#22242C"
        android:padding="10dp"
        android:text="Đang tải trang đăng nhập Shopee... Đăng nhập xong bấm 'LƯU TỰ ĐỘNG'"
        android:textColor="@color/text_secondary"
        android:textSize="12sp" />

    <!-- WebView Container -->
    <WebView
        android:id="@+id/webViewShopee"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

</LinearLayout>
